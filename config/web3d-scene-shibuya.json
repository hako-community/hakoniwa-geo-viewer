{
  "version": "1.0",
  "format": "compact",
  "environmentMode": "physics",
  "environments": [
    {
      "name": "shibuya-terrain",
      "type": "terrain-grid",
      "modes": ["physics", "visual"],
      "terrainGridPath": "../runtime-assets/shibuya/terrain-grid.json",
      "material": {
        "mode": "elevation",
        "lowColor": "#315d45",
        "middleColor": "#9d895f",
        "highColor": "#e7e2d2",
        "wireframe": false,
        "roughness": 0.92,
        "metalness": 0.0
      },
      "debug": {
        "grid": false,
        "gridDivisions": 24,
        "axes": false,
        "axesSizeM": 25.0
      }
    },
    {
      "name": "shibuya-collision-buildings",
      "type": "model",
      "kind": "mjcf",
      "modes": ["physics"],
      "model": "../runtime-assets/shibuya/buildings.xml",
      "material": {
        "mode": "collision-debug",
        "color": "#4b9bd6",
        "opacity": 0.34,
        "depthWrite": false
      }
    },
    {
      "name": "shibuya-plateau-visual",
      "type": "model",
      "modes": ["visual"],
      "optional": true,
      "model": "../assets/models/13113_shibuya-ku_pref_2023_citygml_2_op.glb"
    }
  ],
  "main_camera": {
    "fov": 75,
    "near": 0.1,
    "far": 5000,
    "initialMode": "follow",
    "followDistance": 30.0,
    "followLerpPos": 8.0,
    "followLerpTarget": 10.0,
    "followToggleKey": "c",
    "position": [-20.0, 0.0, 15.0],
    "target": "Drone"
  },
  "defaultDroneProfile": "base",
  "droneProfiles": {
    "base": {
      "label": "Base quadrotor (bundled)",
      "droneTypesPath": "../third_party/hakoniwa-web3d-drone/config/drone_types-quadrotor_base.json",
      "droneType": "quadrotor_base"
    },
    "dji-local": {
      "label": "DJI model (local GLB required)",
      "droneTypesPath": "../third_party/hakoniwa-web3d-drone/config/drone_types-quadrotor_dji.json",
      "droneType": "quadrotor_dji",
      "optionalAssets": true,
      "note": "Place the DJI GLB files under third_party/hakoniwa-web3d-drone/assets/local_models/."
    }
  },
  "droneTypesPath": "../third_party/hakoniwa-web3d-drone/config/drone_types-quadrotor_base.json",
  "drones": [
    {
      "name": "Drone",
      "type": "quadrotor_base",
      "pos": [0.0, 0.0, 20.0],
      "hpr": [0.0, 0.0, 0.0]
    }
  ]
}
